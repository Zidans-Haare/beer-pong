# Beer Pong — Environment Variables
# Copy this file to .env and fill in the values.
# Run `npm run setup` for an interactive wizard that generates .env automatically.

# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_URL="https://your-domain.com"
AUTH_SECRET="generate with: openssl rand -base64 32"
ADMIN_EMAIL="admin@your-domain.com"

# App
APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="Beer Pong"
PORT=3000
NEXT_PUBLIC_LOCALE="en"   # "en" or "de"

# WebAuthn (Passkeys)
WEBAUTHN_RP_ID="your-domain.com"
WEBAUTHN_ORIGIN="https://your-domain.com"
WEBAUTHN_RP_NAME="Beer Pong"

# Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:admin@your-domain.com"

# Email (Resend — optional)
RESEND_API_KEY=""
EMAIL_FROM="noreply@your-domain.com"
ADMIN_EMAIL_CC=""

# Google Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Sentry (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Uptime Kuma (optional)
UPTIME_KUMA_URL=""
UPTIME_KUMA_SLUG=""

# GitHub Repository URL (shown in app footer — optional)
NEXT_PUBLIC_GITHUB_REPO="https://github.com/Zidans-Haare/beer-pong"

# Auto-Deploy Webhook secret (POST /api/deploy)
# Set this as the "Secret" when adding a GitHub webhook to your repo.
DEPLOY_SECRET="generate with: openssl rand -base64 32"
