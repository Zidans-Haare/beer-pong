{
  "name": "beer-pong",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Zidans-Haare/beer-pong.git"
  },
  "bin": {
    "beer-pong-setup": "scripts/setup/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r public .next/standalone/ && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup": "node scripts/setup/index.js",
    "update": "bash scripts/update.sh",
    "seed": "npx tsx prisma/seed.ts",
    "seed:demo": "npx tsx prisma/seed-demo.ts"
  },
