generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id        String   @id @default(uuid())
  name      String
  // Optional contact email for notifications (distinct from User email)
  email     String?  
  nickname  String?
  image     String? // URL to profile image
  bio       String?
  motto     String?
  userId    String?  @unique // Link to Auth User
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user             User?   @relation(fields: [userId], references: [id])
  matchesAsPlayer1 Match[] @relation("Player1Matches")
  matchesAsPlayer2 Match[] @relation("Player2Matches")
  tournaments      TournamentParticipant[]
  standings        TournamentStanding[]
  rsvps            RSVP[]
}

model Tournament {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  location  String
  status    String   @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  type      String   @default("ELIMINATION") // ELIMINATION, ROUND_ROBIN, GROUPS
  hostId    String?  // Creator of the tournament
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hasReturnLeg Boolean @default(false)
  matchDurationMin Int @default(15)
  tableCount       Int @default(1)

  // Relations
  host         User?   @relation(fields: [hostId], references: [id])
  matches      Match[]
  participants TournamentParticipant[]
  standings    TournamentStanding[]
  rsvps        RSVP[]
  tickerEvents TickerEvent[]
}

// ... existing TournamentParticipant, Match, RSVP models ...

// Auth Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For Credentials provider
  accounts      Account[]
  sessions      Session[]
  
  // App Relations
  player        Player?
  hostedTournaments Tournament[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]

  // Notification Preferences
  notifyNewTournaments Boolean @default(true)
  notifyUpdates        Boolean @default(true)
  notifyLiveTicker     Boolean @default(true)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "TOURNAMENT", "UPDATE", "SYSTEM", "GENERIC"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TournamentParticipant {
  idString     String @id @default(uuid())
  tournamentId String
  playerId     String
  
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

model TournamentStanding {
  id           String @id @default(uuid())
  tournamentId String
  playerId     String // Using Player instead of Team
  
  points          Int @default(0)
  goalsFor        Int @default(0)
  goalsAgainst    Int @default(0)
  goalDifference  Int @default(0)
  played          Int @default(0)
  won             Int @default(0)
  drawn           Int @default(0)
  lost            Int @default(0)
  groupId         Int // 0, 1, 2 etc. for Group A, B, C...

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

model Match {
  id           String   @id @default(uuid())
  tournamentId String
  player1Id    String?  // Can be null if TBD
  player2Id    String?
  score1       Int      @default(0)
  score2       Int      @default(0)
  winnerId     String?
  isPlayed     Boolean  @default(false)
  round        Int      // 1, 2, ...
  position     Int      // Position in the bracket
  stage        String   @default("BRACKET") // BRACKET, GROUP
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    Player?    @relation("Player1Matches", fields: [player1Id], references: [id])
  player2    Player?    @relation("Player2Matches", fields: [player2Id], references: [id])
}

model RSVP {
  id           String   @id @default(uuid())
  tournamentId String
  playerId     String
  status       String   @default("NO_RESPONSE") // YES, NO, MAYBE, NO_RESPONSE
  
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

model TickerEvent {
  id           String   @id @default(uuid())
  tournamentId String
  matchId      String?
  type         String   // MATCH_START, SCORE_UPDATE, MATCH_END, COMMENTARY
  content      String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id               String @id @default("default")
  matchDurationMin Int    @default(15)
  tableCount       Int    @default(1)
}
