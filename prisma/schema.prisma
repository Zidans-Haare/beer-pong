generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id               String                  @id @default(uuid())
  name             String
  email            String?
  nickname         String?
  image            String?
  bio              String?
  motto            String?
  userId           String?                 @unique
  isGuest          Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  matchesAsPlayer2 Match[]                 @relation("Player2Matches")
  matchesAsPlayer1 Match[]                 @relation("Player1Matches")
  user             User?                   @relation(fields: [userId], references: [id])
  rsvps            RSVP[]
  teamsAsPlayer2   Team[]                  @relation("TeamPlayer2")
  teamsAsPlayer1   Team[]                  @relation("TeamPlayer1")
  tournaments      TournamentParticipant[]
  standings        TournamentStanding[]
}

model Tournament {
  id                   String                  @id @default(uuid())
  name                 String
  date                 DateTime
  location             String
  status               String                  @default("PLANNED")
  type                 String                  @default("ELIMINATION")
  hostId               String?
  shortCode            String?                 @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  hasReturnLeg         Boolean                 @default(false)
  matchDurationMin     Int                     @default(15)
  tableCount           Int                     @default(1)
  mode                 String                  @default("SOLO")
  isRanked             Boolean                 @default(true)
  image                String?
  offersGuestRoom      Boolean                 @default(false)
  guestRoomTitle       String?
  guestRoomCapacity    Int                     @default(0)
  guestRoomDescription String?
  guestRoomImage       String?
  offersBreakfast      Boolean                 @default(false)
  offersHalfBoard      Boolean                 @default(false)
  bringItems           BringItem[]
  guests               GuestPlayer[]
  matches              Match[]
  rsvps                RSVP[]
  roomReservations     RoomReservation[]
  teams                Team[]
  tickerEvents         TickerEvent[]
  host                 User?                   @relation(fields: [hostId], references: [id])
  participants         TournamentParticipant[]
  standings            TournamentStanding[]
}

model Team {
  id             String       @id @default(uuid())
  name           String?
  tournamentId   String
  player1Id      String?
  guest1Id       String?
  player2Id      String?
  guest2Id       String?
  createdAt      DateTime     @default(now())
  matchesWon     Match[]      @relation("MatchWinnerTeam")
  matchesAsTeam2 Match[]      @relation("MatchTeam2")
  matchesAsTeam1 Match[]      @relation("MatchTeam1")
  guest2         GuestPlayer? @relation("TeamGuest2", fields: [guest2Id], references: [id])
  player2        Player?      @relation("TeamPlayer2", fields: [player2Id], references: [id])
  guest1         GuestPlayer? @relation("TeamGuest1", fields: [guest1Id], references: [id])
  player1        Player?      @relation("TeamPlayer1", fields: [player1Id], references: [id])
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model GuestPlayer {
  id            String     @id @default(uuid())
  name          String
  sessionToken  String     @unique
  tournamentId  String
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamsAsGuest2 Team[]     @relation("TeamGuest2")
  teamsAsGuest1 Team[]     @relation("TeamGuest1")
}

model User {
  id                   String             @id @default(cuid())
  name                 String?
  email                String?            @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  status               String             @default("PENDING")
  notifyNewTournaments Boolean            @default(true)
  notifyUpdates        Boolean            @default(true)
  notifyLiveTicker     Boolean            @default(true)
  accounts             Account[]
  bringItems           BringItem[]
  chatMessages         ChatMessage[]
  notifications        Notification[]
  passkeys             Passkey[]
  player               Player?
  pushSubscriptions    PushSubscription[]
  roomReservations     RoomReservation[]
  sessions             Session[]
  hostedTournaments    Tournament[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BringItem {
  id           String     @id @default(uuid())
  tournamentId String
  category     String
  userId       String
  userName     String
  quantity     Int        @default(1)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, category, userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TournamentParticipant {
  idString     String     @id @default(uuid())
  tournamentId String
  playerId     String
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

model TournamentStanding {
  id             String     @id @default(uuid())
  tournamentId   String
  playerId       String
  points         Int        @default(0)
  goalsFor       Int        @default(0)
  goalsAgainst   Int        @default(0)
  goalDifference Int        @default(0)
  played         Int        @default(0)
  won            Int        @default(0)
  drawn          Int        @default(0)
  lost           Int        @default(0)
  groupId        Int
  player         Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

model Match {
  id              String     @id @default(uuid())
  tournamentId    String
  player1Id       String?
  player2Id       String?
  score1          Int        @default(0)
  score2          Int        @default(0)
  winnerId        String?
  isPlayed        Boolean    @default(false)
  round           Int
  position        Int
  stage           String     @default("BRACKET")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  durationSeconds Int?
  team1Id         String?
  team2Id         String?
  winnerTeamId    String?
  tableNumber     Int?
  player2         Player?    @relation("Player2Matches", fields: [player2Id], references: [id])
  player1         Player?    @relation("Player1Matches", fields: [player1Id], references: [id])
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  winnerTeam      Team?      @relation("MatchWinnerTeam", fields: [winnerTeamId], references: [id])
  team2           Team?      @relation("MatchTeam2", fields: [team2Id], references: [id])
  team1           Team?      @relation("MatchTeam1", fields: [team1Id], references: [id])
}

model RSVP {
  id           String     @id @default(uuid())
  tournamentId String
  playerId     String
  status       String     @default("NO_RESPONSE")
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

model TickerEvent {
  id           String     @id @default(uuid())
  tournamentId String
  matchId      String?
  type         String
  content      String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id               String @id @default("default")
  matchDurationMin Int    @default(15)
  tableCount       Int    @default(1)
  rulesText        String @default("")
}

model UptimeHeartbeat {
  id     Int      @id @default(autoincrement())
  time   DateTime @unique
  status Int
  ping   Int      @default(0)
  msg    String   @default("")
}

model Passkey {
  id                   String    @id @default(cuid())
  userId               String
  credentialId         String    @unique
  credentialPublicKey  Bytes
  counter              BigInt    @default(0)
  credentialDeviceType String    @default("singleDevice")
  credentialBackedUp   Boolean   @default(false)
  transports           String?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?
  friendlyName         String?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoomReservation {
  id           String     @id @default(uuid())
  tournamentId String
  userId       String
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}
